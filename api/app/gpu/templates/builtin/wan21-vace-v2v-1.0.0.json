      },
      "prompt": {
        "type": "string",
        "label": "提示词",
        "default": "Two men at a Chinese street fruit stall, a dramatic confrontation over a watermelon. Preserve the original video composition, camera movement, character positions, body movement, facial expressions, action timing and scene continuity. Original dramatic action manga aesthetics, bold black ink outlines, angular facial features, intense cel shading, deep black shadows, heavy cross-hatching, dramatic purple and gold color palette, exaggerated expressions, supernatural aura, dynamic speed lines, strong perspective, coherent animation, consistent characters and costumes. Maintain the original scene structure and action sequence. Do not introduce new dialogue.",
        "required": true,
        "binding": {
          "node": "14",
          "input": "text"
        }
      },
      "negative_prompt": {
        "type": "string",
        "label": "负向提示词",
        "default": "photorealistic, realistic live action, blurry details, low quality, inconsistent face, identity drift, unstable clothing, extra fingers, extra limbs, deformed anatomy, duplicated characters, random scene changes, flickering, distorted watermelon, unreadable text, watermark, unwanted subtitles",
        "advanced": true,
        "binding": {
          "node": "15",
          "input": "text"
        }
      },
      "start_seconds": {
        "type": "number",
        "label": "片段起点（秒）",
